# Kopieren nach .env und ausfüllen:  cp .env.example .env && chmod 600 .env

# --- foodsharing-Login (Konten mit 2FA werden nicht unterstützt) ---
FOODSHARING_EMAIL=du@example.org
FOODSHARING_PASSWORD=

# Nur ändern, wenn du über eine andere Domain arbeitest (z. B. https://foodsharing.at)
#FOODSHARING_URL=https://foodsharing.de

# --- Telegram (Bot bei @BotFather anlegen, Chat-ID mit --chat-id ermitteln) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Filter (alle optional) ---
# Nur Betriebe im Umkreis (Luftlinie ab der Adresse im foodsharing-Profil)
MAX_DISTANCE_KM=8

# Eigene Startposition statt Profiladresse
#HOME_LAT=51.5
#HOME_LON=7.1

# Statt aller eigenen Bezirke nur diese Region-IDs überwachen (ID steht in der Bezirks-URL)
#REGION_IDS=284,100

# Betriebe, die nie gemeldet werden sollen (ID aus dem Kartenlink ...karte?bid=12345)
#EXCLUDE_IDS=12345,67890

# Betriebe ignorieren, deren Infotext "nur Stammbezirk <Ort>" verlangt
#EXCLUDE_HOME_ONLY=Herne,Bottrop
